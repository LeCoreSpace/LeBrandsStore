{
	"name": "lebrands-store",
	"main": "src/index.js",
	"compatibility_date": "2025-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": false,
"build": {
"command": "node scripts/build-browser-assets.mjs",
"watch_dir": ["src/public", "src/browser-assets.js", "scripts/build-browser-assets.mjs"]
},
	"vars": {
"TURNSTILE_SITE_KEY": "0x4AAAAAAFPIugBBD4F7Xgfb",
"CUSTOM_DOMAIN_CNAME_TARGET": "brands.lebrands.store",
"CLOUDFLARE_WORKER_NAME": "lebrands-store"
	},
	"assets": {
"directory": "./generated-artifacts/public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "lebrands-store-media"
},
{
"binding": "BUSINESS_DOCUMENTS",
"bucket_name": "lebrands-business-documents"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"queues": {
		"producers": [
			{
				"binding": "AI_BUILD_QUEUE",
				"queue": "lebrands-ai-build"
			}
		],
		"consumers": [
			{
				"queue": "lebrands-ai-build",
				"max_batch_size": 1,
				"max_retries": 8
			}
		]
	},
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "cffdd9035815454cb35aa46def7b52a4"
		}
	],
	"routes": [
		{
			"pattern": "lebrands.store/*",
			"zone_name": "lebrands.store"
		},
		{
			"pattern": "*.lebrands.store/*",
			"zone_name": "lebrands.store"
		}
	]
}