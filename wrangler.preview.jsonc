{
  "name": "lebrands-store-local-preview",
  "main": "src/preview.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "build": {
    "command": "node scripts/build-browser-assets.mjs",
    "cwd": "../..",
    "watch_dir": ["src/public", "src/browser-assets.js", "scripts/build-browser-assets.mjs"]
  },
  "vars": { "PREVIEW_LIVE_DATABASE": "enabled",
    "MEDIA_IMAGE_TRIAL_ENABLED": "true",
    "BUSINESS_DOCUMENT_SCAN_PROVIDER": "cloudmersive",
    "BUSINESS_DOCUMENT_SCAN_PROCESSOR_APPROVED": "true" },
  "secrets": {
    "required": ["OPENAI_API", "SUPABASE_APP_DB_URL", "PASSWORD_PEPPER", "SESSION_SECRET", "GSTIN_KEY", "REPLIT_DEV_DOMAIN", "CLOUDMERSIVE_API_KEY", "RAZORPAY_KEY_ID", "RAZORPAY_KEY_SECRET", "RAZORPAY_OAUTH_CLIENT_ID", "RAZORPAY_OAUTH_CLIENT_SECRET", "RAZORPAY_OAUTH_MODE", "RAZORPAY_OAUTH_REDIRECT_URI", "RAZORPAY_OAUTH_WEBHOOK_SECRET"]
  },
  "assets": { "directory": "./generated-artifacts/public", "binding": "ASSETS", "run_worker_first": true },
  "queues": {"producers":[{"binding":"AI_BUILD_QUEUE","queue":"lebrands-ai-build"}],
    "consumers":[{"queue":"lebrands-ai-build","max_batch_size":1,"max_retries":8}]},
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "lebrands-store-media" },
    { "binding": "BUSINESS_DOCUMENTS", "bucket_name": "lebrands-business-documents" }]
}
